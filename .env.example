# Copy to .env for local work (never commit .env). On Netlify, set these under
# Site configuration > Environment variables instead.

# --- Database (Netlify build) -------------------------------------------------
# Netlify DB sets NETLIFY_DATABASE_URL for you. For any other Postgres:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- First run ------------------------------------------------------------------
# 0 = start empty (no demo accounts). Recommended for anything public.
# PARKEASE_SEED_DEMO=0
# Creates the first admin when none exists (password 8+ characters)
# PARKEASE_ADMIN_EMAIL=you@example.com
# PARKEASE_ADMIN_PASSWORD=change-me-please

# --- General -------------------------------------------------------------------
# Long random string used to sign login cookies (default: derived from the database URL)
# PARKEASE_SECRET_KEY=
# Public URL used in e-mailed and payment-return links (default: the Netlify URL)
# PARKEASE_BASE_URL=https://your-site.netlify.app
# PARKEASE_TZ=Asia/Manila
# PARKEASE_REFUND_HOURS=2

# --- Payments (PayMongo). Leave empty to use the fake test checkout ---------------
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_METHODS=gcash,paymaya,card

# --- E-mail. Leave empty to only log e-mails -------------------------------------
# PARKEASE_SMTP_HOST=smtp.gmail.com
# PARKEASE_SMTP_PORT=587
# PARKEASE_SMTP_SECURITY=starttls
# PARKEASE_SMTP_USER=
# PARKEASE_SMTP_PASSWORD=
# PARKEASE_MAIL_FROM=ParkEase <no-reply@example.com>
# PARKEASE_CONTACT_EMAIL=
